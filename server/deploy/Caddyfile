# HTTPS front for the baby monitor. Install to /etc/caddy/Caddyfile.
#
# Caddy's internal CA issues a certificate the first time the board is opened under a
# given name or IP (on-demand TLS), after Flask approves that name. This makes
# https://<board-ip>/ work as well as https://rock-4se/, including on the hotspot.
# Browsers warn once until Caddy's root certificate is trusted:
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
{
	on_demand_tls {
		ask http://127.0.0.1:8000/auth/tls-ask
	}
}

https:// {
	tls internal {
		on_demand
	}

	# WebRTC signalling (WHEP) goes to MediaMTX, but only for logged-in browsers.
	handle /stream/* {
		forward_auth 127.0.0.1:8000 {
			uri /auth/stream
		}
		uri strip_prefix /stream
		reverse_proxy 127.0.0.1:8889 {
			# MediaMTX answers with session URLs relative to its own root.
			header_down Location "^/" "/stream/"
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

# Phone notifications: the ntfy server, for the ntfy app on phones. ntfy wants its
# own origin, so it gets its own port rather than a path.
https://:8443 {
	tls internal {
		on_demand
	}
	reverse_proxy 127.0.0.1:2586 {
		# Subscriptions are long-lived streams.
		flush_interval -1
	}
}
